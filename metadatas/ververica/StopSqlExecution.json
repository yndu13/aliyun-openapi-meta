{
  "name": "StopSqlExecution",
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/namespaces/[namespace]/sql-execution/[sqlExecutionId]:stop",
  "parameters": [
    {
      "name": "namespace",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "sqlExecutionId",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}