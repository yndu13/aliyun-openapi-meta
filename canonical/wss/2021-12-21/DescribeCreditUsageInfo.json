      "location": "query",
      "name": "usage_type",
      "options": [
        "--usage-type"
      ],
      "raw_name": "UsageType",
      "required": false,
      "type": "string"
    },
    {
      "element": {
        "type": "string"
      },
      "help_en": "The instance ID list as a JSON string. This parameter can be omitted when `UsageType=User`. Pass a credit package instance ID when `UsageType=CreditPackage`, or pass an `AgentId` when `UsageType=Agent`",
      "help_zh": "实例 ID 列表 JSON 字符串；`UsageType=User` 时可省略，`CreditPackage` 时传积分包实例 ID，`Agent` 时传 `AgentId`",
      "location": "query",
      "name": "instance_ids",
      "options": [
        "--instance-ids"
      ],
      "param_style": "repeatList",
      "raw_name": "InstanceIds",
      "required": false,
      "type": "array"
    }
  ],
