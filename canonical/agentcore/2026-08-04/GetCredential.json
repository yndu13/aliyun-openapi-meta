{
  "camel_example": "",
  "cmd_full_name": "agentcore get-credential",
  "cmd_name": "get-credential",
  "deprecated": false,
  "description_en": "查询凭证",
  "description_zh": "查询指定凭证的详细信息，并返回已绑定该凭证的智能体列表。凭证内容以脱敏形式返回",
  "kebab_example": "aliyun agentcore get-credential --workspace-id ws-123456 --credential-id cred-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetCredential",
  "operation": {
    "action": "GetCredential",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/credentials/{credentialId}"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspaceId",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "cred-123456",
      "help_en": "The credentialId",
      "help_zh": "凭证 ID",
      "location": "path",
      "name": "credential_id",
      "options": [
        "--credential-id"
      ],
      "raw_name": "credentialId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/credentials/[credentialId]",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_zh": "凭证详情",
            "properties": {
              "boundAgents": {
                "backendName": "boundAgents",
                "description_zh": "已绑定该凭证的智能体列表",
                "items": {
                  "properties": {
                    "agentId": {
                      "backendName": "agentId",
                      "description_zh": "智能体 ID",
                      "example": "agent-123456",
                      "type": "string"
                    },
                    "agentName": {
                      "backendName": "agentName",
                      "description_zh": "智能体名称",
                      "example": "agent-01",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "type": "array"
              },
              "createdAt": {
                "backendName": "createdAt",
                "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "credentialId": {
                "backendName": "credentialId",
                "description_zh": "凭证 ID",
                "example": "cred-123456",
                "type": "string"
              },
              "credentialMetadata": {
                "backendName": "credentialMetadata",
                "description_zh": "凭证内容的脱敏结果。credentialType 为 apiKey 时，apiKey 的取值以等长的 * 返回",
                "example": "{\"apiKey\":\"****************\"}",
                "sensitive": true,
                "type": "string"
              },
              "credentialType": {
                "backendName": "credentialType",
                "description_zh": "凭证类型。当前仅支持 apiKey",
                "example": "apiKey",
                "type": "string"
              },
              "description": {
                "backendName": "description",
                "description_zh": "凭证描述，长度不超过 256 个字符",
                "example": "线上环境调用模型服务使用的 API Key",
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "description_zh": "凭证名称。在工作空间内唯一，只能包含字母、数字、点、下划线和连字符，长度为 3~128 个字符，且不能使用运行时保留名称",
                "example": "model-api-key",
                "type": "string"
              },
              "regionId": {
                "backendName": "regionId",
                "description_zh": "资源所在的地域 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_zh": "工作空间 ID",
                "example": "ws-123456",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
