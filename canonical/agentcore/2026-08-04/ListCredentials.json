{
  "camel_example": "",
  "cmd_full_name": "agentcore list-credentials",
  "cmd_name": "list-credentials",
  "deprecated": false,
  "description_en": "查询凭证列表",
  "description_zh": "分页查询指定工作空间内的凭证。通过 credentialType 按类型过滤，通过 nameLike 按凭证名称模糊过滤，通过 maxResults 指定单页最大记录数，通过 nextToken 获取下一页。未指定 maxResults 时服务端默认返回 10 条",
  "kebab_example": "aliyun agentcore list-credentials --workspace-id ws-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "ListCredentials",
  "operation": {
    "action": "ListCredentials",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/workspaces/{workspaceId}/credentials"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspaceId",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "apiKey",
      "help_en": "The credentialType",
      "help_zh": "按凭证类型过滤。当前仅支持 apiKey",
      "location": "query",
      "name": "credential_type",
      "options": [
        "--credential-type"
      ],
      "raw_name": "credentialType",
      "required": false,
      "type": "string"
    },
    {
      "example": "model",
      "help_en": "The nameLike",
      "help_zh": "按凭证名称模糊匹配的过滤条件",
      "location": "query",
      "name": "name_like",
      "options": [
        "--name-like"
      ],
      "raw_name": "nameLike",
      "required": false,
      "type": "string"
    },
    {
      "example": "10",
      "help_en": "The maxResults",
      "help_zh": "单页返回的最大记录数，取值范围为 1~100。不指定该参数时默认返回 10 条",
      "location": "query",
      "name": "max_results",
      "options": [
        "--max-results"
      ],
      "raw_name": "maxResults",
      "required": false,
      "type": "int"
    },
    {
      "example": "10",
      "help_en": "The nextToken",
      "help_zh": "查询下一页的游标。首次调用不指定该参数，后续调用指定上一次返回的 nextToken",
      "location": "query",
      "name": "next_token",
      "options": [
        "--next-token"
      ],
      "raw_name": "nextToken",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/credentials",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "items": {
            "backendName": "items",
            "description_zh": "凭证列表",
            "items": {
              "properties": {
                "boundAgentsCounts": {
                  "backendName": "boundAgentsCounts",
                  "description_zh": "已绑定该凭证的智能体数量",
                  "example": "2",
                  "format": "int32",
                  "type": "integer"
                },
                "createdAt": {
                  "backendName": "createdAt",
                  "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                  "example": "2026-08-12T03:04:05Z",
                  "type": "string"
                },
                "credentialId": {
                  "backendName": "credentialId",
                  "description_zh": "凭证 ID",
                  "example": "cred-123456",
                  "type": "string"
                },
                "credentialMetadata": {
                  "backendName": "credentialMetadata",
                  "description_zh": "凭证内容的脱敏结果。credentialType 为 apiKey 时，apiKey 的取值以等长的 * 返回",
                  "example": "{\"apiKey\":\"****************\"}",
                  "sensitive": true,
                  "type": "string"
                },
                "credentialType": {
                  "backendName": "credentialType",
                  "description_zh": "凭证类型。当前仅支持 apiKey",
                  "example": "apiKey",
                  "type": "string"
                },
                "description": {
                  "backendName": "description",
                  "description_zh": "凭证描述，长度不超过 256 个字符",
