                  "type": "string"
                },
                "name": {
                  "backendName": "name",
                  "description_zh": "凭证名称。在工作空间内唯一，只能包含字母、数字、点、下划线和连字符，长度为 3~128 个字符，且不能使用运行时保留名称",
                  "example": "model-api-key",
                  "type": "string"
                },
                "regionId": {
                  "backendName": "regionId",
                  "description_zh": "资源所在的地域 ID",
                  "example": "cn-hangzhou",
                  "type": "string"
                },
                "updatedAt": {
                  "backendName": "updatedAt",
                  "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                  "example": "2026-08-12T03:04:05Z",
                  "type": "string"
                },
                "workspaceId": {
                  "backendName": "workspaceId",
                  "description_zh": "工作空间 ID",
                  "example": "ws-123456",
                  "type": "string"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "maxResults": {
            "backendName": "maxResults",
            "description_zh": "本次查询生效的单页最大记录数",
            "example": "10",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "nextToken": {
            "backendName": "nextToken",
            "description_zh": "下一页游标。没有下一页时为空",
            "example": "10",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "请求是否成功",
            "type": "boolean"
          },
          "totalCount": {
            "backendName": "totalCount",
            "description_zh": "符合查询条件的凭证总数",
            "example": "42",
            "format": "int64",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  }
}
