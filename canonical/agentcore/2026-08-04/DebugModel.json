                "format": "int64",
                "type": "integer"
              },
              "latencyMs": {
                "backendName": "latencyMs",
                "description_zh": "本次模型调试调用耗时，单位为毫秒",
                "example": "12",
                "format": "int64",
                "type": "integer"
              },
              "modelId": {
                "backendName": "modelId",
                "description_zh": "模型 ID",
                "example": "model-1",
                "type": "string"
              },
              "outputTokens": {
                "backendName": "outputTokens",
                "description_zh": "本次模型调试响应消耗的输出 Token 数量",
                "example": "2",
                "format": "int64",
                "type": "integer"
              },
              "response": {
                "backendName": "response",
                "description_zh": "模型调试成功时返回的模型文本响应；调试失败时为空",
