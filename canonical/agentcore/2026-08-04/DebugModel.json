                "type": "string"
              },
              "status": {
                "backendName": "status",
                "description_en": "调试结果状态。取值：NORMAL（正常）、ABNORMAL（异常）",
                "description_zh": "调试结果状态",
                "example": "NORMAL",
                "title_en": "调试结果状态",
                "title_zh": "调试结果状态",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "HTTP 状态码。成功时为 200",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "请求处理结果消息",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID",
            "example": "request-1",
            "type": "string"
          },
          "success": {
