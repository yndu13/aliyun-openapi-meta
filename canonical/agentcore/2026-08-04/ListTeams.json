    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "list",
    "url": "/workspaces/{workspaceId}/teams"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspaceId",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
