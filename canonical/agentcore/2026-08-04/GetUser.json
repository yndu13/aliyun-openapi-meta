{
  "camel_example": "",
  "cmd_full_name": "agentcore get-user",
  "cmd_name": "get-user",
  "deprecated": false,
  "description_en": "查询用户",
  "description_zh": "查询指定工作空间内某个用户的详细信息。用户不存在时返回错误",
  "kebab_example": "aliyun agentcore get-user --workspace-id ws-123456 --agent-core-user-id usr-123456 --region cn-hangzhou",
  "method": "GET",
  "multi_version": false,
  "name": "GetUser",
  "operation": {
    "action": "GetUser",
    "api_style": "ROA",
    "api_version": "2026-08-04",
    "method": "GET",
    "operation_type": "read",
    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": "/workspaces/{workspaceId}/users/{agentCoreUserId}"
  },
  "parameters": [
    {
      "example": "ws-123456",
      "help_en": "The workspaceId",
      "help_zh": "工作空间 ID",
      "location": "path",
      "name": "workspace_id",
      "options": [
        "--workspace-id"
      ],
      "raw_name": "workspaceId",
      "required": true,
      "type": "string"
    },
    {
      "example": "usr-123456",
      "help_en": "The agentCoreUserId",
      "help_zh": "用户 ID",
      "location": "path",
      "name": "agent_core_user_id",
      "options": [
        "--agent-core-user-id"
      ],
      "raw_name": "agentCoreUserId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "/workspaces/[workspaceId]/users/[agentCoreUserId]",
  "product_code": "AgentCore",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "code": {
            "backendName": "code",
            "description_zh": "业务状态码",
            "example": "SUCCESS",
            "type": "string"
          },
          "data": {
            "backendName": "data",
            "description_zh": "用户详情",
            "properties": {
              "agentCoreUserId": {
                "backendName": "userId",
                "description_zh": "用户 ID",
                "example": "usr-123456",
                "type": "string"
              },
              "authMethod": {
                "backendName": "authMethod",
                "description_zh": "用户的认证方式。password 表示使用工作空间本地密码认证，dingtalk 和 feishu 表示由对应的外部身份提供商同步并认证",
                "example": "password",
                "type": "string"
              },
              "createdAt": {
                "backendName": "createdAt",
                "description_zh": "创建时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "displayName": {
                "backendName": "displayName",
                "description_zh": "用户显示名称，长度为 1~32 个字符",
                "example": "张三",
                "type": "string"
              },
              "email": {
                "backendName": "email",
                "description_zh": "用户邮箱地址，长度不超过 256 个字符",
                "example": "user-01@example.com",
                "sensitive": true,
                "type": "string"
              },
              "name": {
                "backendName": "name",
                "description_zh": "用户名称。在工作空间内唯一，只能包含小写字母、数字和连字符，必须以小写字母或数字开头和结尾，长度为 1~32 个字符",
                "example": "user-01",
                "type": "string"
              },
              "note": {
                "backendName": "note",
                "description_zh": "用户备注，长度不超过 1024 个字符",
                "example": "智能体运营组成员",
                "type": "string"
              },
              "regionId": {
                "backendName": "regionId",
                "description_zh": "资源所在的地域 ID",
                "example": "cn-hangzhou",
                "type": "string"
              },
              "status": {
                "backendName": "status",
                "description_zh": "用户状态。可选值：Creating、Active、Updating、Deleting、Failed、DeleteFailed",
                "enum": [
                  "Creating",
                  "Active",
                  "Updating",
                  "Deleting",
                  "Failed",
                  "DeleteFailed"
                ],
                "example": "Active",
                "type": "string"
              },
              "updatedAt": {
                "backendName": "updatedAt",
                "description_zh": "最近一次修改的时间，采用 RFC 3339 格式的 UTC 时间",
                "example": "2026-08-12T03:04:05Z",
                "type": "string"
              },
              "workspaceId": {
                "backendName": "workspaceId",
                "description_zh": "工作空间 ID",
                "example": "ws-123456",
                "type": "string"
              }
            },
            "type": "object"
          },
          "httpStatusCode": {
            "backendName": "httpStatusCode",
            "description_zh": "HTTP 状态码",
            "example": "200",
            "format": "int32",
            "type": "integer"
          },
          "message": {
            "backendName": "message",
            "description_zh": "响应消息。请求失败时返回错误描述",
            "example": "success",
            "type": "string"
          },
          "requestId": {
            "backendName": "requestId",
            "description_zh": "请求 ID",
            "example": "request-123456",
            "type": "string"
          },
          "success": {
            "backendName": "success",
            "description_zh": "请求是否成功",
            "type": "boolean"
          }
        },
        "type": "object"
      }
    }
  }
}
