        "--biz-language"
      ],
      "raw_name": "Language",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "ResourceManager",
  "protocol": "HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "ControlPolicy": {
            "backendName": "data.controlPolicy",
            "description_en": "The details of the access control policy",
            "description_zh": "管控策略详情",
            "nullToEmpty": false,
            "properties": {
              "AttachmentCount": {
                "backendName": "attachmentCount",
                "description_en": "The number of times that the access control policy is referenced",
                "description_zh": "管控策略被引用的次数",
                "example": "0",
                "type": "string",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "createDate",
                "description_en": "The time when the access control policy was created",
                "description_zh": "管控策略创建时间",
                "example": "2021-03-18T08:51:33Z",
                "type": "string",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "description",
                "description_en": "The description of the access control policy",
                "description_zh": "管控策略描述",
                "example": "ExampleControlPolicy",
                "type": "string",
                "visibility": "Public"
              },
              "EffectScope": {
                "backendName": "effectScope",
                "description_en": "The effective scope of the access control policy. Valid values:\n\nAll: The access control policy is in effect for Alibaba Cloud accounts, RAM users, and RAM roles.\nRAM: The access control policy is in effect only for RAM users and RAM roles",
                "description_zh": "管控策略生效范围。取值：\n\nAll：表示该管控策略针对阿里云账号、RAM用户或RAM角色生效。\nRAM：表示该管控策略仅针对RAM用户或RAM角色生效",
                "example": "RAM",
                "type": "string",
                "visibility": "Public"
              },
              "PolicyDocument": {
                "backendName": "policyDocument",
                "description_en": "The document of the access control policy",
                "description_zh": "管控策略内容",
                "example": "{\\\"Version\\\":\\\"1\\\",\\\"Statement\\\":[{\\\"Effect\\\":\\\"Deny\\\",\\\"Action\\\":[\\\"ram:UpdateRole\\\",\\\"ram:DeleteRole\\\",\\\"ram:AttachPolicyToRole\\\",\\\"ram:DetachPolicyFromRole\\\"],\\\"Resource\\\":\\\"acs:ram:*:*:role/ResourceDirectoryAccountAccessRole\\\"}]}",
                "type": "string",
                "visibility": "Public"
              },
              "PolicyId": {
                "backendName": "policyId",
                "description_en": "The ID of the access control policy",
                "description_zh": "管控策略ID",
                "example": "cp-SImPt8GCEwiq****",
                "type": "string",
                "visibility": "Public"
              },
              "PolicyName": {
                "backendName": "policyName",
                "description_en": "The name of the access control policy",
                "description_zh": "管控策略名称",
                "example": "test",
                "type": "string",
                "visibility": "Public"
              },
              "PolicyType": {
                "backendName": "policyType",
                "description_en": "The type of the access control policy. Valid values:\n\nSystem: system access control policy\nCustom: custom access control policy",
                "description_zh": "管控策略类型。取值：\n\nSystem：系统管控策略。\nCustom：自定义管控策略",
                "example": "Custom",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "updateDate",
                "description_en": "The time when the access control policy was updated",
                "description_zh": "管控策略更新时间",
                "example": "2021-03-18T08:51:33Z",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "requestId",
            "description_en": "The ID of the request",
