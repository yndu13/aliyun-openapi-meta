      "help_zh": "权限策略版本标识",
      "location": "query",
      "name": "version_id",
      "options": [
        "--version-id"
      ],
      "raw_name": "VersionId",
      "required": true,
      "type": "string"
    }
  ],
  "pathPattern": "",
