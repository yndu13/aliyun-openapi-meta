    "protocol": "HTTPS",
    "system_operation_type": "get",
    "url": ""
  },
  "parameters": [
    {
      "enum": [
        "Custom",
        "System"
      ],
      "example": "Custom",
      "help_en": "The type of the permission policy. Valid values:\n\nCustom\nSystem",
