{
  "camel_example": "",
  "cmd_full_name": "oos start-execution",
  "cmd_name": "start-execution",
  "deprecated": false,
  "description_en": "Starts an execution",
  "description_zh": "启动一个执行",
  "kebab_example": "",
  "method": "GET|POST",
  "multi_version": false,
  "name": "StartExecution",
  "operation": {
    "action": "StartExecution",
    "api_style": "RPC",
    "api_version": "2019-06-01",
    "method": "POST",
    "operation_type": "write",
    "protocol": "HTTPS",
    "system_operation_type": "update",
    "url": ""
  },
  "parameters": [
    {
      "example": "cn-hangzhou",
      "help_en": "The ID of the region",
      "help_zh": "地域ID",
      "location": "query",
      "name": "region_id",
      "options": [
        "--biz-region-id"
      ],
      "raw_name": "RegionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "vmeixme",
      "help_en": "The name of the template. The name can contain letters, digits, hyphens (-), and underscores (_). The name can be up to 200 characters in length",
      "help_zh": "模板名称。内容限制为字母、数字、中划线、下划线，长度200字符",
      "location": "query",
      "name": "template_name",
      "options": [
        "--template-name"
      ],
      "raw_name": "TemplateName",
      "required": false,
      "type": "string"
    },
    {
      "example": "v1",
      "help_en": "The version number of the template. If you do not specify this parameter, the latest version is used",
      "help_zh": "版本号，如不填默认为最新的版本号",
      "location": "query",
      "name": "template_version",
      "options": [
        "--template-version"
      ],
      "raw_name": "TemplateVersion",
      "required": false,
      "type": "string"
    },
    {
      "example": "Automatic",
      "help_en": "The execution mode. Valid values:\n\nAutomatic (default): The execution is automatically run.\n\nFailurePause: The execution is paused if a task fails.\n\nDebug: The execution is run in single-step mode",
      "help_zh": "执行模式。取值：\nAutomatic（默认值）：自动执行\nFailurePause：失败暂停\nDebug：单步执行",
      "location": "query",
      "name": "mode",
      "options": [
        "--biz-mode"
      ],
      "raw_name": "Mode",
      "required": false,
      "type": "string"
    },
    {
      "example": "Automatic",
      "help_en": "The loop mode. Valid values:\n\nAutomatic (default): The execution is not paused.\n\nFirstBatchPause: The execution is paused after the first batch of tasks is completed.\n\nEveryBatchPause: The execution is paused after each batch of tasks is completed",
      "help_zh": "循环模式。取值：\nAutomatic（默认值）：不暂停\nFirstBatchPause：第一批暂停\nEveryBatchPause：每批暂停",
      "location": "query",
      "name": "loop_mode",
      "options": [
        "--loop-mode"
      ],
      "raw_name": "LoopMode",
      "required": false,
      "type": "string"
    },
    {
      "example": "exec-xxx",
      "help_en": "The ID of the parent execution",
      "help_zh": "父执行ID",
      "location": "query",
      "name": "parent_execution_id",
      "options": [
        "--parent-execution-id"
      ],
      "raw_name": "ParentExecutionId",
      "required": false,
      "type": "string"
    },
    {
      "example": "Skip",
      "help_en": "The security check mode. Valid values:\n\nSkip (default): This option indicates that you are aware of the risks. The system performs all actions without asking for confirmation, regardless of the risk level. This mode is valid only when Mode is set to `Automatic`.\n\nConfirmEveryHighRiskAction: This option requires you to confirm every high-risk action. You can call the NotifyExecution operation to confirm or cancel an action",
      "help_zh": "安全检查模式。取值：\n\nSkip（默认值）：此选项表示客户了解风险，无需确认即可执行任何Action，无论什么风险等级。`Mode=Automatic`时有效。\nConfirmEveryHighRiskAction：此选项会要求客户确认每一个高风险的Action。客户通过调用NotifyExecution接口进行确认或取消",
      "location": "query",
      "name": "safety_check",
      "options": [
        "--safety-check"
      ],
      "raw_name": "SafetyCheck",
      "required": false,
      "type": "string"
    },
    {
      "example": "{\"Status\":\"Running\"}",
      "help_en": "The JSON string that consists of a collection of parameters. The default value is {}",
      "help_zh": "由参数集合组成的Json字符串，默认为{}",
      "location": "query",
      "name": "parameters",
      "options": [
        "--parameters"
      ],
      "raw_name": "Parameters",
      "required": false,
      "type": "string"
    },
    {
      "example": "123e56767-e89b-12d3-a456-426655440000",
      "help_en": "The client token that is used to ensure the idempotency of the request",
      "help_zh": "访问令牌",
      "location": "query",
      "name": "client_token",
      "options": [
        "--client-token"
      ],
      "raw_name": "ClientToken",
      "required": false,
      "type": "string"
    },
    {
      "example": "{\n      \"k1\": \"v1\",\n      \"k2\": \"v2\"\n}",
      "help_en": "The tags to add to the execution",
      "help_zh": "要给执行打的标签",
      "location": "query",
      "name": "tags",
      "options": [
        "--tags"
      ],
      "param_style": "json",
      "raw_name": "Tags",
      "required": false,
      "type": "map",
      "value": {
        "type": "any"
      }
    },
    {
      "example": "test execution.",
      "help_en": "The description of the execution",
      "help_zh": "要给执行添加的描述信息",
      "location": "query",
      "name": "description",
      "options": [
        "--description"
      ],
      "raw_name": "Description",
      "required": false,
      "type": "string"
    },
    {
      "example": "{   \"Description\": \"Example template, describe instances in some status\",   \"FormatVersion\": \"OOS-2019-06-01\",   \"Parameters\": {},   \"Tasks\": [     {       \"Name\": \"describeInstances\",       \"Action\": \"ACS::ExecuteAPI\",       \"Description\": \"desc-en\",       \"Properties\": {         \"Service\": \"ECS\",         \"API\": \"DescribeInstances\",         \"Parameters\": {           \"Status\": \"Running\"         }       }     }   ] }",
      "help_en": "The content of the template, which must be in the JSON or YAML format. This parameter is the same as the Content request parameter of the CreateTemplate operation. You can specify this parameter to run the tasks in the template content without the need to create a template. You do not need to specify this parameter if you use an existing template to create an execution",
      "help_zh": "模板内容，JSON或YAML格式（同CreateTemplate API 请求参数中的Content字段）。用户传入此字段可直接执行TemplateContent中的任务，而无需提前创建模板再创建执行任务（当用户选择已有的Template创建执行任务时不需传入此字段）",
      "location": "query",
      "name": "template_content",
      "options": [
        "--template-content"
      ],
      "raw_name": "TemplateContent",
      "required": false,
      "type": "string"
    },
    {
      "example": "rg-acfmxsn4m4******",
      "help_en": "The ID of the resource group",
      "help_zh": "资源组ID",
      "location": "query",
      "name": "resource_group_id",
      "options": [
        "--resource-group-id"
      ],
      "raw_name": "ResourceGroupId",
      "required": false,
      "type": "string"
    },
    {
      "example": "http://oos-template.cn-hangzhou.oss.aliyun-inc.com/oos-test-template.json",
      "help_en": "The URL of the Object Storage Service (OSS) object that stores the OOS template content. The URL must be a public-read URL. You can specify this parameter to run the tasks in the template content that is stored in the OSS object without the need to create a template. You do not need to specify this parameter if you use an existing template to create an execution",
      "help_zh": "阿里云对象存储OSS中存放OOS模板内容的URL(只支持公共读的URL)。用户传入此字段可直接根据行TemplateURL中存储的模板内容创建执行任务，无需提前创建模板再创建执行任务（当用户选择已有的Template创建执行任务时不需传入此字段）",
      "location": "query",
      "name": "template_url",
      "options": [
        "--template-url"
      ],
      "raw_name": "TemplateURL",
      "required": false,
      "type": "string"
    }
  ],
  "pathPattern": "",
  "product_code": "oos",
  "protocol": "HTTP|HTTPS",
  "responses": {
    "200": {
      "schema": {
        "properties": {
          "Execution": {
            "backendName": "Execution",
            "description_en": "The data of the execution",
            "description_zh": "执行数据",
            "properties": {
              "Counters": {
                "backendName": "Counters",
                "description_en": "The number of executions",
                "description_zh": "执行数",
                "example": "1",
                "mappingResourcePropertyName": "$.Counters",
                "type": "object",
                "visibility": "Public"
              },
              "CreateDate": {
                "backendName": "CreateDate",
                "description_en": "The time when the execution was created",
                "description_zh": "执行创建时间",
                "example": "2019-05-16T10:26:14Z",
                "mappingResourcePropertyName": "$.CreateTime",
                "type": "string",
                "visibility": "Public"
              },
              "CurrentTasks": {
                "backendName": "CurrentTasks",
                "description_en": "The tasks that are running",
                "description_zh": "当前正在运行的Tasks",
                "itemName": "CurrentTask",
                "items": {
                  "properties": {
                    "TaskAction": {
                      "backendName": "TaskAction",
                      "description_en": "The action of the task",
                      "description_zh": "任务的动作",
                      "example": "ACS::TimerTrigger",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "TaskExecutionId": {
                      "backendName": "TaskExecutionId",
                      "description_en": "The ID of the task execution",
                      "description_zh": "任务执行ID",
                      "example": "exec-dsadasdawq",
                      "type": "string",
                      "visibility": "Public"
                    },
                    "TaskName": {
                      "backendName": "TaskName",
                      "description_en": "The name of the task",
                      "description_zh": "任务名称",
                      "example": "testTask",
                      "type": "string",
                      "visibility": "Public"
                    }
                  },
                  "type": "object"
                },
                "nullToEmpty": true,
                "type": "array",
                "visibility": "Public"
              },
              "Description": {
                "backendName": "Description",
                "description_en": "The description of the execution",
                "description_zh": "执行的描述信息",
                "example": "test execution.",
                "mappingResourcePropertyName": "$.Description",
                "type": "string",
                "visibility": "Public"
              },
              "EndDate": {
                "backendName": "EndDate",
                "description_en": "The time when the execution ended",
                "description_zh": "结束时间",
                "example": "2019-05-16T10:26:14Z",
                "mappingResourcePropertyName": "$.EndDate",
                "type": "string",
                "visibility": "Public"
              },
              "ExecutedBy": {
                "backendName": "ExecutedBy",
                "description_en": "The user who started the execution",
                "description_zh": "执行模板者",
                "example": "root(13092080xx12344)",
                "mappingResourcePropertyName": "$.ExecutedBy",
                "type": "string",
                "visibility": "Public"
              },
              "ExecutionId": {
                "backendName": "ExecutionId",
                "description_en": "The unique ID of the execution",
                "description_zh": "执行的唯一标识",
                "example": "exec-xxxyyy",
                "mappingResourcePropertyName": "$.ExecutionId",
                "type": "string",
                "visibility": "Public"
              },
              "IsParent": {
                "backendName": "IsParent",
                "description_en": "Indicates whether the execution contains child tasks",
                "description_zh": "是否包含子任务",
                "example": "false",
                "mappingResourcePropertyName": "$.IsParent",
                "type": "boolean",
                "visibility": "Public"
              },
              "LoopMode": {
                "backendName": "LoopMode",
                "description_en": "The loop mode",
                "description_zh": "循环模式",
                "example": "Automatic",
                "mappingResourcePropertyName": "$.LoopMode",
                "type": "string",
                "visibility": "Public"
              },
              "Mode": {
                "backendName": "Mode",
                "description_en": "The execution mode",
                "description_zh": "执行模式",
                "example": "Automatic",
                "mappingResourcePropertyName": "$.Mode",
                "type": "string",
                "visibility": "Public"
              },
              "Outputs": {
                "backendName": "Outputs",
                "description_en": "The outputs of the execution",
                "description_zh": "执行输出结果",
                "example": "{ \"InstanceId\":\"i-xxx\" }",
                "mappingResourcePropertyName": "$.Outputs",
                "type": "string",
                "visibility": "Public"
              },
              "Parameters": {
                "backendName": "Parameters",
                "description_en": "The input parameters of the execution",
                "description_zh": "执行的输入参数",
                "example": "{ \"Status\":\"Running\" }",
                "mappingResourcePropertyName": "$.Parameters",
                "type": "string",
                "visibility": "Public"
              },
              "ParentExecutionId": {
                "backendName": "ParentExecutionId",
                "description_en": "The ID of the parent execution",
                "description_zh": "父执行ID",
                "example": "exec-xxxx",
                "mappingResourcePropertyName": "$.ParentExecutionId",
                "type": "string",
                "visibility": "Public"
              },
              "RamRole": {
                "backendName": "RamRole",
                "description_en": "The RAM role that is used to run the template",
                "description_zh": "执行当前模板的角色",
                "example": "OOSServiceRole",
                "mappingResourcePropertyName": "$.RamRole",
                "type": "string",
                "visibility": "Public"
              },
              "ResourceGroupId": {
                "backendName": "ResourceGroupId",
                "description_en": "The ID of the resource group",
                "description_zh": "资源组ID",
                "example": "rg-acfmxsn4m4******",
                "mappingResourcePropertyName": "$.ResourceGroupId",
                "type": "string",
                "visibility": "Public"
              },
              "SafetyCheck": {
                "backendName": "SafetyCheck",
                "description_en": "The security check mode",
                "description_zh": "安全检查模式",
                "example": "Skip",
                "mappingResourcePropertyName": "$.SafetyCheck",
                "type": "string",
                "visibility": "Public"
              },
              "StartDate": {
                "backendName": "StartDate",
                "description_en": "The time when the execution started",
                "description_zh": "开始时间",
                "example": "2019-05-16T10:26:14Z",
                "mappingResourcePropertyName": "$.StartDate",
                "type": "string",
                "visibility": "Public"
              },
              "Status": {
                "backendName": "Status",
                "description_en": "The status of the execution",
                "description_zh": "执行状态",
                "example": "Success",
                "mappingResourcePropertyName": "$.Status",
                "type": "string",
                "visibility": "Public"
              },
              "StatusMessage": {
                "backendName": "StatusMessage",
                "description_en": "The status message",
                "description_zh": "状态信息",
                "example": "\"\"",
                "mappingResourcePropertyName": "$.StatusMessage",
                "type": "string",
                "visibility": "Public"
              },
              "Tags": {
                "backendName": "Tags",
                "description_en": "The tags of the execution",
                "description_zh": "执行的标签",
                "example": "{\"k1\":\"v2\",\"k2\":\"v2\"}",
                "type": "object",
                "visibility": "Public"
              },
              "TemplateId": {
                "backendName": "TemplateId",
                "description_en": "The ID of the template",
                "description_zh": "模板ID",
                "example": "t-1bd341007f",
                "mappingResourcePropertyName": "$.TemplateId",
                "type": "string",
                "visibility": "Public"
              },
              "TemplateName": {
                "backendName": "TemplateName",
                "description_en": "The name of the template",
                "description_zh": "模板名称",
                "example": "MyTemplate",
                "mappingResourcePropertyName": "$.TemplateName",
                "type": "string",
                "visibility": "Public"
              },
              "TemplateVersion": {
                "backendName": "TemplateVersion",
                "description_en": "The version number of the template",
                "description_zh": "模板版本号",
                "example": "v1",
                "mappingResourcePropertyName": "$.TemplateVersion",
                "type": "string",
                "visibility": "Public"
              },
              "UpdateDate": {
                "backendName": "UpdateDate",
                "description_en": "The time when the execution was last updated",
                "description_zh": "更新时间",
                "example": "2019-05-16T10:26:14Z",
                "mappingResourcePropertyName": "$.UpdateDate",
                "type": "string",
                "visibility": "Public"
              }
            },
            "type": "object",
            "visibility": "Public"
          },
          "RequestId": {
            "backendName": "RequestId",
            "description_en": "The ID of the request",
            "description_zh": "请求ID",
            "example": "14A07460-EBE7-47CA-9757-12CC4761D47A",
            "type": "string",
            "visibility": "Public"
          }
        },
        "type": "object"
      }
    }
  }
}
