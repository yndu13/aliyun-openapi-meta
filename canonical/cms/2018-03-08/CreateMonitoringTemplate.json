  },
  "parameters": [
    {
      "example": "Monitor_Template",
      "help_en": "The name of the monitoring template",
      "help_zh": "监视模板名称",
      "location": "query",
      "name": "name",
      "options": [
        "--name"
      ],
      "raw_name": "Name",
      "required": true,
      "type": "string"
    },
    {
      "example": "acs_ecs_dashboard\n",
      "help_en": "The namespace of the template. This value has the same semantics as the namespace exposed by metric master",
      "help_zh": "模板命名空间，语义同metric master对外开放的命名空间",
      "location": "query",
      "name": "namespace",
      "options": [
        "--namespace"
      ],
      "raw_name": "Namespace",
      "required": true,
      "type": "string"
    },
    {
      "example": "{\n  \"ecs\": [\n    {\n      \"displayName\": \"ECS_cpu_total\",\n      \"category\": \"ecs\",\n      \"namespace\": \"acs_ecs_dashboard\",\n      \"metricName\": \"cpu_total\",\n      \"selector\": {}, \n      \"escalations\": {\n        \"warn\": {\n          \"statistics\": \"Average\",\n          \"comparisonOperator\": \"GreaterThanOrEqualToThreshold\",\n          \"threshold\": \"80\",\n          \"times\": 3\n        },\n        \"critical\": {\n          \"statistics\": \"Average\",\n          \"comparisonOperator\": \"GreaterThanOrEqualToThreshold\",\n          \"threshold\": \"95\",\n          \"times\": 3\n        }\n      }\n    }\n  ],\n  \"rds\": [\n    {\n      \"displayName\": \"RDS_CpuUsage\",\n      \"category\": \"rds\",\n      \"namespace\": \"acs_rds_dashboard\",\n      \"metricName\": \"CpuUsage\",\n      \"selector\": {},\n      \"escalations\": {\n        \"critical\": {\n          \"statistics\": \"Average\",\n          \"comparisonOperator\": \"GreaterThanOrEqualToThreshold\",\n          \"threshold\": \"90\",\n          \"times\": 5\n        }\n      }\n    }\n  ]\n}",
      "help_en": "The alert template",
      "help_zh": "报警模板配置（JSON 字符串）。\n\n该字段并非扁平数组，而是一个按云产品分类的嵌套对象。\n\n第一层为 Map 结构，Key 为云产品代码（如 ecs、rds、mongodb），Value 为该产品的报警规则列表。\n\n第二层为具体的规则对象，包含以下核心字段：\n\ndisplayName 为报警规则显示名称；\n\ncategory 为产品分类，需与外层 Key 保持一致；\n\nnamespace 为云监控命名空间；\n\nmetricName 为具体的监控项名称；\n\nselector 为资源筛选器，空对象代表应用到分组下所有实例；\n\nescalations 为报警升级策略配置对象，包含 info（信息）、warn（警告）、critical（严重）三个等级。每个等级下需配置四个关键参数：statistics 为统计方法（枚举值包括 Average、Maximum、Minimum、Sum）；\n\ncomparisonOperator 为阈值比较符（如 GreaterThanOrEqualToThreshold）；\n\nthreshold 为报警阈值，注意必须为字符串格式的数字；\n\ntimes 为连续探测次数，即连续 N 个统计周期满足条件才触发报警",
      "location": "query",
      "name": "alert_templates_json",
      "options": [
        "--alert-templates-json"
      ],
      "raw_name": "AlertTemplatesJson",
      "required": true,
      "type": "string"
    },
    {
      "example": "description",
      "help_en": "The description of the monitoring template",
      "help_zh": "监视模板描述",
      "location": "query",
      "name": "description",
      "options": [
        "--description"
      ],
      "raw_name": "Description",
      "required": false,
      "type": "string"
    },
    {
      "example": "[{\"alertName\":\"WAF_Event\",\"description\":\"WAF_Event\",\"eventPattern\":{\"eventType\":[\"*\"],\"levelList\":[\"*\"],\"nameList\":[\"*\"],\"product\":\"waf\"},\"fcParameterList\":[],\"mnsParameterList\":[],\"notifyLevel\":3,\"slsParameterList\":[],\"webhookParameterList\":[]}]",
      "help_en": "The system event template",
      "help_zh": "系统事件模板",
      "location": "query",
      "name": "system_event_templates",
      "options": [
        "--system-event-templates"
      ],
      "raw_name": "SystemEventTemplates",
      "required": false,
      "type": "string"
    },
    {
      "example": "[{\"alert\":{\"comparisonOperator\":\"LessThanThreshold\",\"escalationsLevel\":\"critical\",\"silenceTime\":0,\"statistics\":\"Average\",\"templateAlert\":false,\"threshold\":\"2\",\"times\":1},\"matchExpress\":{\"filterRelation\":\"and\",\"filters\":[{\"function\":\"all\",\"name\":\"name\",\"value\":\"*\"}]},\"processName\":\"FineBI\"}]",
      "help_en": "The process monitoring template",
      "help_zh": "进程监控模板",
      "location": "query",
      "name": "process_monitor_templates",
      "options": [
        "--process-monitor-templates"
      ],
      "raw_name": "ProcessMonitorTemplates",
      "required": false,
      "type": "string"
    },
    {
      "example": "[{\"alert\":{\"escalationList\":[{\"aggregate\":\"Value\",\"metric\":\"TelnetStatus\",\"operator\":\">\",\"times\":3,\"value\":\"400\"},{\"aggregate\":\"Average\",\"metric\":\"TelnetLatency\",\"operator\":\">\",\"times\":3,\"value\":\"500\"}],\"notifyType\":1,\"silenceTime\":86400},\"taskName\":\"telnet\",\"taskOption\":{\"method\":\"HEAD\",\"negative\":true,\"resposeCharset\":\"utf-8\",\"uri\":\"telnet://xxx.com\"},\"taskType\":\"TELNET\"},{\"alert\":{\"escalationList\":[{\"aggregate\":\"Value\",\"metric\":\"TelnetStatus\",\"operator\":\">\",\"times\":3,\"value\":\"400\"},{\"aggregate\":\"Average\",\"metric\":\"TelnetLatency\",\"operator\":\">\",\"times\":3,\"value\":\"500\"}],\"notifyType\":1,\"silenceTime\":86400},\"taskName\":\"bbbbbbbbbb\",\"taskOption\":{\"method\":\"HEAD\",\"negative\":true,\"resposeCharset\":\"utf-8\",\"uri\":\"telnet://xxx.com\"},\"taskType\":\"TELNET\"}]",
      "help_en": "The availability monitoring template",
      "help_zh": "可用性监控模板",
      "location": "query",
