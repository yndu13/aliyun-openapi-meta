{
  "name": "UpgradeClusterAddons",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/upgrade",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "The cluster ID.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "The request parameters.",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "component_name",
          "description": "The component name.",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "config",
          "description": "The custom parameters of the component, encoded as a JSON string.",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "next_version",
          "description": "The target version to which you want to upgrade. You can call the `DescribeAddon` operation to query the versions to which the component can be upgraded.",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "policy",
          "description": "The component upgrade policy. Valid values:\n- overwrite: overwrites the existing version.\n- canary: performs a canary upgrade.",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "version",
          "description": "The current component version.",
          "position": "Body",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
