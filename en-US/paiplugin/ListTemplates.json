{
  "name": "ListTemplates",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/templates",
  "parameters": [
    {
      "name": "Content",
      "description": "Template content filter.  ",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "Template name filter.  ",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "Page number, starting from 1. Default value is 1.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size. Default value is 10.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Status",
      "description": "Review status filter.  \n- 0: Under review.  \n- 1: Pass.  \n- 2: Failed.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Type",
      "description": "Template type filter.  \n- 0: Verification code.  \n- 1: Notification.  \n- 2: Promotional message.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
