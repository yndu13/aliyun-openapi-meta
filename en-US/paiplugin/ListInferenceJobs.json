{
  "name": "ListInferenceJobs",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/inference/jobs",
  "parameters": [
    {
      "name": "CampaignId",
      "description": "Filters prediction tasks by operational activity ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "CampaignName",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "Filters prediction tasks by name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "The page number, starting from 1. Default is 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "The number of items per page. Default is 10.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Remark",
      "description": "Filters prediction tasks by remark.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Status",
      "description": "Filters prediction tasks by status.\n\n- 0: Queued.\n\n- 1: Submitted.\n\n- 2: Running.\n\n- 3: Succeeded.\n\n- 4: Failed.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "TrainingJobName",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
