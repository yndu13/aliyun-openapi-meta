    },
    {
      "name": "Name",
      "description": "Filter by algorithm name.  ",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "Page number, starting from 1. Default value is 1.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size. Default value is 10.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
