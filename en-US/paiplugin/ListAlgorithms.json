{
  "name": "ListAlgorithms",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/algorithms",
  "parameters": [
    {
      "name": "Id",
      "description": "Filter by algorithm ID.  ",
      "position": "Query",
      "type": "String",
