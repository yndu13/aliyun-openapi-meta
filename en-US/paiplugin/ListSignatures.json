{
  "name": "ListSignatures",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/signatures",
  "parameters": [
    {
      "name": "Name",
      "description": "Filter by sign name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "Page number. Starts from 1. Default value: 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size. Default value: 10.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Status",
      "description": "Filter by sign review status.  \n- 0: Under review.  \n- 1: Pass.  \n- 2: Failed.",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
