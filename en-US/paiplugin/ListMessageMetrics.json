{
  "name": "ListMessageMetrics",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/messages/metrics",
  "parameters": [
    {
      "name": "EndDate",
      "description": "End date, in the format 20220102.",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "GroupId",
      "description": "Associated Audience ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "Page number, starting from 1. Default value is 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size. Default value is 10.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "ScheduleId",
      "description": "Associated Reach plan ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Signature",
      "description": "Signature name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SignatureId",
      "description": "Signature ID. You can specify either the signature name or the signature ID, but not both.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartDate",
      "description": "Start date, in the format YYYYMMDD (for example, 20220102).",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "TemplateCode",
      "description": "Template ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TemplateId",
      "description": "Template ID. You can specify either Template Code or Template ID, but not both.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TemplateType",
      "description": "Template type.\n- 0: verification code.\n- 1: notification.\n- 2: promotional message.",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
