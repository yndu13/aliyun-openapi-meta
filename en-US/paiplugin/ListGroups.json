{
  "name": "ListGroups",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/groups",
  "parameters": [
    {
      "name": "Name",
      "description": "Audience name filter.  ",
      "position": "Query",
      "type": "String",
