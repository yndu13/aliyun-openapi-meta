      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "Remark",
      "description": "Audience remark filter.  ",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Source",
      "description": "Source filter.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Status",
      "description": "Review status filter.  ",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
