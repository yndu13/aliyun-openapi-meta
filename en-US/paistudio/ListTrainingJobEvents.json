{
  "name": "ListTrainingJobEvents",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/trainingjobs/[TrainingJobId]/events",
  "parameters": [
    {
      "name": "EndTime",
      "description": "End UTC time (ISO8601 format). If empty, it is the current time.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "Page number (default is 1).",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size (default is 100).",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "Start UTC time (ISO8601 format). If empty, it is the task start time.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TrainingJobId",
      "description": "Training task ID.",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ]
}
