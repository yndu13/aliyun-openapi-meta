  "pathPattern": "/api/v1/jobs/[jobId]/dashboard",
  "parameters": [
    {
      "name": "isShared",
      "description": "Indicates whether this is a shared link. If it is, the \\`token\\` parameter is also required.",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "jobId",
      "description": "Job ID",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "token",
      "description": "The token obtained from GetToken.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
