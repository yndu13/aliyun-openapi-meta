{
  "name": "ListProject",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/project",
  "parameters": [
    {
      "name": "keyword",
      "description": "The search keyword. Name-based search is supported.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "The page number. Default value: 1.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "The number of results per page. Default value: 20. Minimum value: 1. Maximum value: 100.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "tag",
      "description": "The list of tags.",
      "position": "Query",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "key",
          "description": "The tag key.",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "value",
          "description": "The tag value.",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
