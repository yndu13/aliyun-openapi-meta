{
  "name": "UnbindNlb",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/pop/v1/sam/app/nlb",
  "parameters": [
    {
      "name": "AppId",
      "description": "The application ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NlbId",
      "description": "The NLB instance ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Port",
      "description": "The listener port, which must be between 0 and 65535.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Protocol",
      "description": "The protocol. Valid values:\n\n- **TCP**\n\n- **UDP**\n\n- **TCPSSL**",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
