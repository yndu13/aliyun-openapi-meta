{
  "name": "ListInstanceAccount",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/instances/[instanceId]/accounts",
  "parameters": [
    {
      "name": "accountStatus",
      "description": "The status of the account.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "accountType",
      "description": "The type of the account.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "instanceId",
      "description": "The ID of the RocketMQ instance.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageNumber",
      "description": "The page number. The first page is 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "The number of entries to return on each page.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "username",
      "description": "The username of the account.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
