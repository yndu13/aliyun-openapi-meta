{
  "name": "ListConfigs",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/configs/[ClusterId]/[ConfigType]/[Name]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "**The service region.** (Required)",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigType",
      "description": "**The configuration type.** (Required) Only `service` is supported.",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "**The service name.** (Required)",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Page",
      "description": "**The page number.** Default: 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "**The number of entries per page.** Default: 100. Maximum: 200.",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
