{
  "name": "ListEvalResults",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/PAILLMTrace/eval/results",
  "parameters": [
    {
      "name": "EvaluationId",
      "description": "The ID of the evaluation task. Will return the latest evaluation result if this ID not provied.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Keyword",
      "description": "The search key word.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "The number of the page to return.\n- Pages start from page 1.\n- Default value: 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "Page size, default is 10.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "RecordIds",
      "description": "The IDs of the traces.",
      "position": "Query",
      "type": "RepeatList",
      "required": false
    }
  ]
}
