{
  "name": "ListMmsTimers",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/mms/datasources/[sourceId]/timers",
  "parameters": [
    {
      "name": "name",
      "description": "The timer name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNum",
      "description": "The page number.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "The number of entries per page.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "sourceId",
      "description": "The data source ID.",
      "position": "Path",
      "type": "Long",
      "required": true
    },
    {
      "name": "srcDbName",
      "description": "The source database name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "srcTableName",
      "description": "The source table name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "stopped",
      "description": "Filters timers by their stopped state.",
      "position": "Query",
      "type": "Boolean",
      "required": false
    }
  ]
}
