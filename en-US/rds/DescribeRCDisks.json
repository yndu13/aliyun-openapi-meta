      "type": "String",
      "required": false
    },
    {
      "name": "DiskType",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "InstanceId",
      "description": "The instance ID.\n",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "The page number.\n",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "The number of entries per page. Valid values: **30** to **100**. Default value: **30**.\n",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "RegionId",
