{
  "name": "ListInstances",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/services/[serviceName]/functions/[functionName]/instances",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "description": "Your Alibaba Cloud account ID.",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Date",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Trace-Id",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "functionName",
      "description": "Name of the function.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "instanceIds",
      "description": "The ID of the instance.",
      "position": "Query",
      "type": "RepeatList",
      "required": false
    },
    {
      "name": "limit",
      "description": "Maximum number of instances to return. Valid values: 0 to 1000.\n\nThe actual number of results may be less than this value, but never more.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "qualifier",
      "description": "Version or alias.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "serviceName",
      "description": "Name of the service.",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ]
}
