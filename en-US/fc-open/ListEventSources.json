{
  "name": "ListEventSources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/2021-04-06/services/[serviceName]/functions/[functionName]/event-sources",
  "parameters": [
    {
      "name": "X-Fc-Account-Id",
      "description": "Your Alibaba Cloud account ID.",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Date",
      "description": "The start date of the function invocation, in the format of **EEE,d MMM yyyy HH:mm:ss GMT**.",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "X-Fc-Trace-Id",
      "description": "The trace ID of the Function Compute invocation request.",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "functionName",
      "description": "The function name.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "qualifier",
      "description": "The alias or version.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "serviceName",
      "description": "The service name.",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ]
}
