{
  "name": "GlobalSearch",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/linked-retrieval/linked-retrieval-entry/v1/iqs/search/global",
  "parameters": [
    {
      "name": "page",
      "description": "Page number, starting from 1",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "Number of items per page",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "query",
      "description": "Search query content",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "timeRange",
      "description": "Web page publish time range",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
