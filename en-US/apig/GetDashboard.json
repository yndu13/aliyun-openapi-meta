{
  "name": "GetDashboard",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/gateways/[gatewayId]/dashboards",
  "parameters": [
    {
      "name": "acceptLanguage",
      "description": "The language. Valid values:\n- zh: Chinese\n- en: English",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "apiId",
      "description": "The unique ID of the API.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "filter",
      "description": "The filter configuration.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "gatewayId",
      "description": "The unique identifier of the gateway.",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "description": "The dashboard name. Valid values:\n- LOG: access log\n- PLUGIN: plug-in log",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pluginClassId",
      "description": "The plug-in type ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pluginId",
      "description": "The plug-in ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "routeId",
      "description": "The route ID.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "source",
      "description": "The dashboard source. Valid values:\n- SLS: log dashboard",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "upstreamCluster",
      "description": "The AI service identifier.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
