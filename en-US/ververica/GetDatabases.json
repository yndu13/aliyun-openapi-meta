{
  "name": "GetDatabases",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/catalogs/[catalogName]/databases",
  "parameters": [
    {
      "name": "catalogName",
      "description": "The catalog name.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "databaseName",
      "description": "The database name. If this parameter is left empty, information about all databases is returned.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "description": "The project namespace.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "workspace",
      "description": "The workspace ID.",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
