{
  "name": "ListScheduledPlan",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/namespaces/[namespace]/scheduled-plans",
  "parameters": [
    {
      "name": "deploymentId",
      "description": "The ID of the job.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "description": "The name of the namespace.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageIndex",
      "description": "The page number to return. The default value is 1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "The number of entries to return on each page. The default value is 10. The maximum value is 100.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "workspace",
      "description": "The workspace ID.",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
