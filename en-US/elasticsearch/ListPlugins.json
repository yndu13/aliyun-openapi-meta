{
  "name": "ListPlugins",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/openapi/instances/[InstanceId]/plugins",
  "parameters": [
    {
      "name": "InstanceId",
      "description": "The instance ID.",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "name",
      "description": "The plugin name.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "page",
      "description": "The page number.",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "size",
      "description": "The number of records per page.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "source",
      "description": "The plugin source type. Only SYSTEM (system plugin) is supported.",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
