{
  "name": "ListRayHistoryServers",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/rayhistoryservers",
  "parameters": [
    {
      "name": "DisplayName",
      "description": "任务的显示名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "EndTime",
      "description": "查询区间的截止时间；使用任务的创建时间来过滤。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "IdPrefix",
      "description": " ID前缀",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ModifiedAfter",
      "description": "按修改后时间过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Order",
      "description": "排序顺序。\n- desc：降序。\n- asc：升序。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "分页查询，指定当前需要返回的页码，从1开始往后编号。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "分页查询中，指定每页返回的RayHistoryServer数量。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PaymentType",
      "description": "付费类型。\n- PrePaid\n- PostPaid",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ResourceId",
      "description": "资源组ID。如何查询专有资源组ID，详情请参见[管理资源配额](~~2651299~~)。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ShowOwn",
      "description": "是否只返回当前登录者所创建的RayHistoryServer。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "SortBy",
      "description": "按返回的以下字段排序。\n- DisplayName\n- GmtCreateTime\n- UserId\n- ResourceId\n- Status\n- GmtModifyTime",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StartTime",
      "description": "开始时间。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Status",
      "description": "RayHistoryServer 状态：\n- Creating：创建中。\n- Queuing：排队中。\n- Running：运行中。\n- Stopped：已停止。\n- Failed：已失败。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StoragePath",
      "description": "Ray 日志存储路径",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "UserIdForFilter",
      "description": "按用户ID过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Username",
      "description": "按用户名称过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "WorkspaceId",
      "description": "工作空间ID。<props=\"china\">如何获取工作空间ID，请参见[ListWorkspaces](~~449124~~)。</props>",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
