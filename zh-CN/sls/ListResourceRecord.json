{
  "name": "ListResourceRecord",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/resources/[resourceName]/records",
  "parameters": [
    {
      "name": "ids",
      "description": "按记录 ID 过滤，多个 ID 使用半角逗号分隔，最多 200 个。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "includeSystemRecords",
      "description": "是否包含系统内置记录。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "jsonFilterAcc",
      "description": "是否启用 JSON 过滤加速。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "jsonPath",
      "description": "JSON 字段路径；与 jsonPathValue 配合使用。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "jsonPathValue",
      "description": "JSON 字段的过滤值；与 jsonPath 配合使用。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "offset",
      "description": "查询起始位置。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "resourceName",
      "description": "资源名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "search",
      "description": "在记录内容中搜索指定字符串。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "size",
      "description": "本次返回的最大记录数，取值范围为 1~200。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "sjson",
      "description": "按 JSON 内容搜索。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "tag",
      "description": "按记录标签过滤。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
