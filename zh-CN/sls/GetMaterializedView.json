{
  "name": "GetMaterializedView",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/materializedviews/[name]",
  "parameters": [
    {
      "name": "Content-Type",
      "description": "响应内容类型。目前Log Service服务端响应类型支持application/json、application/x-protobuf两种类型。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "description": "数据视图名称。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "project",
      "description": "Project名称。",
      "position": "Host",
      "type": "String",
      "required": false
    },
    {
      "name": "returnStatus",
      "description": "是否返回MV状态信息",
      "position": "Query",
      "type": "Boolean",
      "required": false
    }
  ]
}
