{
  "name": "SearchTenantTableKnowledge",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "DbId",
      "description": "数据库ID，可选。传入时在指定库内找表；不传时为租户级跨库找表。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Limit",
      "description": "返回表知识条数上限，默认20，最大50",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Model",
      "description": "选用的模型名称，仅可用千问系列",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Query",
      "description": "自然语言找表描述",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SessionId",
      "description": "会话ID，可选",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
