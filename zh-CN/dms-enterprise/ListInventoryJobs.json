{
  "name": "ListInventoryJobs",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "Offset",
      "description": "分页偏移量，默认0",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Query",
      "description": "搜索关键词，支持任务 ID（数字或 task_ 前缀）或创建人名称模糊匹配",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Size",
      "description": "每页返回条数，默认20，最大100",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "SortBy",
      "description": "排序字段",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SortOrder",
      "description": "排序方向，可选值：asc（正序）、desc（倒序），默认desc",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Status",
      "description": "任务状态筛选",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
