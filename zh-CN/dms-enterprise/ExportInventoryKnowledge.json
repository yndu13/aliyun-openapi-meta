{
  "name": "ExportInventoryKnowledge",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "JobId",
      "description": "盘点任务ID",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "Query",
      "description": "搜索关键词，用于模糊匹配知识内容",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ShowType",
      "description": "知识展示类型筛选，如 TABLE、COLUMN、SQL、SEG、LINEAGE、TERM 等",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SortBy",
      "description": "排序字段，可选值：confidence、entityId，默认confidence",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SortOrder",
      "description": "排序方向，可选值：asc（正序）、desc（倒序），默认desc",
