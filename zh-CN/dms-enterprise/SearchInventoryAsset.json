{
  "name": "SearchInventoryAsset",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/",
  "parameters": [
    {
      "name": "JobId",
      "description": "盘点任务ID",
      "position": "Query",
      "type": "Long",
      "required": true
    },
    {
      "name": "Offset",
      "description": "分页偏移量，默认0",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Query",
      "description": "搜索关键词，用于模糊匹配表名等资产信息",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Size",
      "description": "每页返回条数，默认20，最大100",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "SortBy",
      "description": "排序字段，可选值：confidence、entityId，默认confidence",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SortOrder",
      "description": "排序方向，可选值：asc（正序）、desc（倒序），默认desc",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
