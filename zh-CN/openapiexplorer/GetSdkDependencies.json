{
  "name": "GetSdkDependencies",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/sdk/dependencies",
  "parameters": [
    {
      "name": "callType",
      "description": "SDK调用类型，typed为产品专属SDK模式，generic为Common泛化调用模式，默认为typed。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "language",
      "description": "SDK编程语言，用于过滤返回的SDK版本信息。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "product",
      "description": "云产品Code。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "version",
      "description": "OpenAPI版本。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
