{
  "name": "ListSnapshots",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/2023-03-30/snapshots",
  "parameters": [
    {
      "name": "functionName",
      "description": "函数名称",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "limit",
      "description": "本次最多返回的快照数量，取值范围 1-100，默认 20。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "剩余列表的起始层名，用来返回更多结果。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "qualifier",
      "description": "函数别名",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "sessionId",
      "description": "创建快照的源SessionID。指定时必须同时指定 functionName。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
