{
  "name": "PauseSession",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/2023-03-30/functions/[functionName]/sessions/[sessionId]/pause",
  "parameters": [
    {
      "name": "fileSystemOnly",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "functionName",
      "description": "Session 的函数名称",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "qualifier",
      "description": "需要保存的会话 ID 关联的函数别名或版本信息",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "sessionId",
      "description": "需要保存的会话 ID 值",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ]
}
