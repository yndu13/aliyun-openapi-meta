{
  "name": "CreateNatGateway",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "EnsRegionId",
      "description": "ENS节点ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "InstanceBillingCycle",
      "description": "实例计费周期。取值：Hour（小时）、Month（月）。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "InstanceType",
      "description": "NAT规格。取值：**enat.default**。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "NAT网关名称。长度为1~128个字符，但不能以`http://`或`https://`开头。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NetworkId",
      "description": "网络ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Tag",
      "description": "资源标签",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "实例的标签键。N的取值范围为**1**~**20**。\n\n- 不能以`aliyun`、`acs:`、`http://`或`https://`开头。\n- 最多支持64个字符。\n- 不允许传入空字符串。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Value",
          "description": "资源的标签值。N 的取值范围：1~20。一旦传入该值，可以为空字符串。最多支持 128 个字符，不能以acs:开头，不能包含http://或者https://。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    },
    {
      "name": "VSwitchId",
      "description": "交换机ID。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
