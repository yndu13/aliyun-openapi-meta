{
  "name": "PutCustomEvent",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "EventInfo",
      "description": "事件信息列表。",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "sub_parameters": [
        {
          "name": "Content",
          "description": "事件内容。N的取值范围：1~50。",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "EventName",
          "description": "事件名称。N的取值范围：1~50。",
          "position": "Query",
          "type": "String",
          "required": true
        },
        {
          "name": "GroupId",
          "description": "应用分组ID。N的取值范围：0~50。\n\n默认值：0.0表示上报的事件不属于任何一个应用分组。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Time",
          "description": "发生事件的时间。\n\n格式：`yyyyMMddTHHmmss.SSSZ`（年月日时分秒.毫秒时区）。\n\nN的取值范围：1~50。\n\n> 您还可以输入Unix时间（例如：1552199984000）。单位：毫秒。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
