{
  "name": "CreatePrivateDnsEndpoint",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "AccessInstanceName",
      "description": "私有实例名称。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "FirewallType",
      "description": "云防火墙类型。取值：\n- **internet**\n- **vpc**\n- **nat**",
      "position": "Query",
      "type": "RepeatList",
      "required": true
    },
    {
      "name": "IpProtocol",
      "description": "IP协议。取值：\n- **TCP**\n- **UDP**",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "MemberUid",
      "description": "阿里云成员账号的UID。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "Port",
      "description": "端口号。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PrimaryDns",
      "description": "主DNS。\n> PrivateDnsType=Custom时 PrimaryDns/StandbyDns 需自行提供。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PrimaryVSwitchId",
      "description": "主交换机 ID。本参数必填，缺失时返回 -200103；PrimaryVSwitchId 和 StandbyVSwitchId 所在地域及可用区必须支持私有 DNS 防火墙。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PrimaryVSwitchIp",
      "description": "主交换机ip。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PrivateDnsType",
      "description": "私有DNS类型。当 PrivateDnsType=Custom 时 Port、IpProtocol 为条件必填；PrivateZone 时后端自动填充为 53/默认协议。取值：\n- **PrivateZone**\n- **Custom**（默认）",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "RegionNo",
      "description": "实例所在的地域ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "StandbyDns",
      "description": "备DNS。\n\n> PrivateDnsType=Custom 时 PrimaryDns/StandbyDns 需自行提供。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StandbyVSwitchId",
      "description": "备交换机id。PrimaryVSwitchId / StandbyVSwitchId 所在可用区需为当前支持私有 DNS 的可用区，否则返回 -200534；地域也需在支持列表内。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "StandbyVSwitchIp",
      "description": "备交换机ip。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "VpcId",
      "description": "VPC实例ID。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ]
}
