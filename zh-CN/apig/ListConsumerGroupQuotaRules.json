{
  "name": "ListConsumerGroupQuotaRules",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/consumer-groups/[consumerGroupId]/quota-rules",
  "parameters": [
    {
      "name": "consumerGroupId",
      "description": "消费者组ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "gatewayId",
      "description": "网关ID，可选；传入后按网关ID精确过滤。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "keyword",
      "description": "规则名称关键词，可选；按规则名称模糊匹配。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码，默认值为1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页数量，默认值为10，取值范围为1～500。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
