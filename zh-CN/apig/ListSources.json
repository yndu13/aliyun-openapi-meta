{
  "name": "ListSources",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/sources",
  "parameters": [
    {
      "name": "gatewayId",
      "description": "网关ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "分页页码，从1开始，不填默认1.",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "分页大小，有效范围[1, 100]，不填默认10。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "resourceGroupId",
      "description": "按资源组过滤（同时参与 RAM 鉴权）",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "type",
      "description": "根据来源类型查询。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
