      "type": "String",
      "required": false
    },
    {
      "name": "keyword",
      "description": "规则名称关键词，用于模糊匹配",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页数量",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
