{
  "name": "ListConsumerQuotaRules",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/consumers/[consumerId]/quota-rules",
  "parameters": [
    {
      "name": "consumerId",
      "description": "消费者ID，此参数为路径参数，实际必填；未提供时 SDK 无法构建请求 URI，可通过 ListConsumers API 查询已有消费者列表获取，或通过 CreateConsumer API 创建新消费者后获取。",
      "position": "Path",
      "type": "String",
