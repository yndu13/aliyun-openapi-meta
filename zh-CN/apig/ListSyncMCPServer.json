{
  "name": "ListSyncMCPServer",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/mcp-servers/sync-mcp-server/list",
  "parameters": [
    {
      "name": "gatewayId",
      "description": "AI 网关 ID",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "description": "Nacos 命名空间 ID",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "sourceId",
      "description": "Nacos 服务来源 ID；单 Nacos 来源场景可省略（服务端自动填充唯一来源），多 Nacos 来源场景必填（否则报 sourceId 为空的参数错误）；网关无 Nacos 来源时报 ErrServiceSourceNotFound",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
