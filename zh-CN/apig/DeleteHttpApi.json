{
  "name": "DeleteHttpApi",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/v1/http-apis/[httpApiId]",
  "parameters": [
    {
      "name": "dryRun",
      "description": "是否只做预检校验（dry run）。true 时执行与真实删除一致的全部同步校验（含已发布不可删等删除准入判定）但不删除 API、不清理任何关联配置、不产生副作用；缺省或 false 时行为与现有版本一致。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "httpApiId",
      "description": "待删除的HTTP API ID。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ]
}
