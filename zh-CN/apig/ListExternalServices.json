{
  "name": "ListExternalServices",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/gateways/[gatewayId]/external-services",
  "parameters": [
    {
      "name": "gatewayId",
      "description": "网关id，精确搜索。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "importableOnly",
      "description": "是否只返回\"尚未导入\"的服务",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "limit",
      "description": "限制返回数量，有效范围(0, 100]，不填默认10",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nameLike",
      "description": "按接口名称模糊搜索",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "paiWorkspaceId",
      "description": "PAI-EAS服务的工作空间id",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "sourceType",
      "description": "根据服务来源类型查询, 服务来源：\n- MSE_NACOS:  来源为MSE Nacos里的服务。\n- K8S: 来源为容器服务里K8S集群里的服务。\n- FC3: 来源为函数计算里的服务。\n- VIP: 来源为固定地址的服务。\n- DNS: 来源为域名的服务。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
