{
  "name": "ListRiskCheckResults",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/gateways/[gatewayId]/risk-check/results",
  "parameters": [
    {
      "name": "gatewayId",
      "description": "网关 ID（网关必须存在，否则透传错误）",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "maxResults",
      "description": "本次返回的最大记录数。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "分页Token",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码，缺省默认 1（DefaultPageNumber）",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "页大小，缺省默认 10（DefaultPageSize）",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
