{
  "name": "ListInstallableGateways",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/plugin-classes/[pluginClassId]/installable-gateways",
  "parameters": [
    {
      "name": "gatewayType",
      "description": "网关类型过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页数量",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pluginClassId",
      "description": "插件类 ID（路径参数，ClassPathParams 非空校验）；插件类必须存在",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ]
}
