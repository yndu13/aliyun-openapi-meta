{
  "name": "GetHttpApi",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/http-apis/[httpApiId]",
  "parameters": [
    {
      "name": "expandPolicyConfigs",
      "description": "是否展开独立策略配置。省略或设置为true时返回完整兼容视图；设置为false时，Policy管理的ModelAPI Token限流返回策略引用和可选只读插件状态，规则正文可通过GetPolicy读取。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "httpApiId",
      "description": "目标HTTP API ID。",
      "position": "Path",
      "type": "String",
      "required": true
    }
  ]
}
