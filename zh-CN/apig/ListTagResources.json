{
  "name": "ListTagResources",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/tags",
  "parameters": [
    {
      "name": "NextToken",
      "description": "下一个查询开始Token",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ResourceId",
      "description": "资源ID,最多 50个子项，ResourceId 与 Tag 至少须提供其一，两者均为空时 API 返回 InvalidParameter.BothEmpty(400)。",
      "position": "Query",
      "type": "Json",
      "required": false
    },
    {
      "name": "ResourceType",
      "description": "资源类型",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
