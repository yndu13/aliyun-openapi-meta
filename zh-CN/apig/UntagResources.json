{
  "name": "UntagResources",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/v1/tags",
  "parameters": [
    {
      "name": "All",
      "description": "是否全部删除，只针对tags为空时有效。取值范围： true  false True False   默认是 false",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "ResourceId",
      "description": "资源ID,最多 50个子项",
      "position": "Query",
      "type": "Json",
      "required": false
    },
    {
      "name": "ResourceType",
      "description": "资源类型",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TagKey",
      "description": "对应标签键列表，最多包含20个子项",
      "position": "Query",
      "type": "Json",
      "required": false
    }
  ]
}
