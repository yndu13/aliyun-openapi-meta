{
  "name": "ListGlobalPolicies",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/global-policies",
  "parameters": [
    {
      "name": "attachResourceType",
      "description": "按挂载资源类型过滤（仅 BlackOrWhite 生效）；缺省查 Gateway/Domain/Route 三类",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "className",
      "description": "策略类名，支持逗号分隔多值（服务端 strings.Split）",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "enable",
      "description": "按启用状态过滤",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "environmentId",
      "description": "按环境过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "gatewayId",
      "description": "按网关过滤（attachment 维度）",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "globalPolicyType",
      "description": "全局策略类型",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ipAccessControlContent",
      "description": "按 IP 内容过滤（对 config 做 LIKE）",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ipAccessControlProtocolLayer",
      "description": "按协议层过滤：L4 查 config 含 L4，L7 查不含 L4",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ipAccessControlResourceName",
      "description": "按资源名称过滤（对 config 做 LIKE）",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ipAccessControlType",
      "description": "IP 访问控制类型过滤（对 config 做 LIKE）",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "name",
      "description": "按策略名精确过滤",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "页码，默认1",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页数量。",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
