{
  "name": "ListBatchExportTasks",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/v1/http-api-batch-export-tasks",
  "parameters": [
    {
      "name": "endTime",
      "description": "创建时间结束值，RFC3339格式。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "gatewayId",
      "description": "网关实例ID，传入后仅返回该网关下的任务。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "maxResults",
      "description": "单次查询返回的最大任务数量。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "nextToken",
      "description": "分页查询的起始标记。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "pageNumber",
      "description": "分页页码。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "分页大小。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "startTime",
      "description": "创建时间起始值，RFC3339格式。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "statuses",
      "description": "任务状态列表，多个状态使用英文逗号分隔。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
