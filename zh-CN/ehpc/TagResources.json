{
  "name": "TagResources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "description": "资源所属的地域ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ResourceId",
      "description": "资源ID，最多50个。",
      "position": "Query",
      "type": "RepeatList",
      "required": true
    },
    {
      "name": "ResourceType",
      "description": "资源类型。目前仅支持cluster，即E-HPC集群。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Tag",
      "description": "标签列表，最多20个。",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "标签键。一旦传入该值，则不允许为空字符串。最多支持128个字符，不能以`aliyun`和`acs:`开头，不能包含`http://`或者`https://`。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Value",
          "description": "标签值。一旦传入该值，则不允许为空字符串。最多支持128个字符，不能以`aliyun`和`acs:`开头，不能包含`http://`或者`https://`。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
