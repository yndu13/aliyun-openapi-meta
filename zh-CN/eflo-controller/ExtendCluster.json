{
  "name": "ExtendCluster",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "IgnoreFailedNodeTasks",
      "description": "是否允许跳过失败节点，默认值为False",
      "position": "Body",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "IpAllocationPolicy",
      "description": "分配IP的组合策略： 每个策略只能选择一种策略类型，可以有多个策略进行组合",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "BondPolicy",
          "description": "根据bond名称指定集群子网ID",
          "position": "FormData",
          "type": "Struct",
          "required": false
        },
        {
          "name": "MachineTypePolicy",
          "description": "机型分配策略",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "NodePolicy",
          "description": "节点分配策略",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        }
      ]
    },
    {
      "name": "NodeGroups",
      "description": "节点组",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "Amount",
          "description": "购买节点的数量。取值范围：0～500。  如果 Amount 参数取值为 0，则表示不购买节点，使用已有节点进行扩容。 如果 Amount 参数取值为 1～500，则表示购买一定数量节点，并使用购买的节点进行扩容。 默认值：0",
          "position": "FormData",
          "type": "Long",
          "required": false
        },
        {
          "name": "AutoRenew",
          "description": "购买的节点是否要自动续费。当 Amount 参数取值不为 0 且 ChargeType 取值为 PREPAY或POSTPAY 时，该参数生效。取值范围： True：自动续费 ; False：不自动续费。 默认值：False",
          "position": "FormData",
          "type": "Boolean",
          "required": false
        },
        {
          "name": "ChargeType",
          "description": "节点的付费方式。当 Amount 参数取值为 0 时，该参数不生效。取值范围： PREPAY：包年包月；POSTPAY：按量付费。 默认值：PREPAY。",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "Hostnames",
          "description": "设置购买节点的主机名。当 Amount 参数取值为 0 时，该参数不生效。",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "HyperNodes",
          "description": "超节点列表",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "LoginPassword",
          "description": "设置购买节点的登录密码。当 Amount 参数取值为 0 时，该参数不生效。",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "NodeGroupId",
          "description": "节点组ID",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "NodeTag",
          "description": "节点标签",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "Nodes",
          "description": "节点列表",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        },
        {
          "name": "Period",
          "description": "购买节点的时长（单位：月）。取值范围：1、6、12、24、36、48。当 Amount 参数取值不为 0 且 ChargeType 取值为 PREPAY 时，该参数生效。",
          "position": "FormData",
          "type": "Long",
          "required": false
        },
        {
          "name": "SavingsPlanId",
          "description": "节省计划ID",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "UserData",
          "description": "自定义可执行shell脚本，需要以 Base64 方式编码，原始数据最多为 16 KB。",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "VSwitchId",
          "description": "交换机ID",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "VpcId",
          "description": "专有网络ID",
          "position": "FormData",
          "type": "String",
          "required": false
        },
        {
          "name": "ZoneId",
          "description": "可用区ID",
          "position": "FormData",
          "type": "String",
          "required": false
        }
      ]
    },
    {
      "name": "VSwitchZoneId",
      "description": "交换机可用区ID",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "VpdSubnets",
      "description": "集群子网列表",
      "position": "Body",
      "type": "Json",
      "required": false
    }
  ]
}
