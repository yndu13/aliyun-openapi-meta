{
  "name": "UpdateSkill",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "BundleUrl",
      "description": "bundle.zip 的可下载地址（http/https）。与 SkillMdOverride 二选一；传入则替换 bundle。\n",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "Description",
      "description": "Skill 描述。\n",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "ExpectedVersion",
      "description": "乐观锁期望版本号；不传则基于当前最高版本更新。\n",
      "position": "Body",
      "type": "Integer",
      "required": false
    },
    {
      "name": "Extra",
      "description": "扩展元数据（键值对）。\n",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "要更新的 Skill 名称。\n",
      "position": "Body",
      "type": "String",
      "required": true
    },
    {
      "name": "SkillMdOverride",
      "description": "SKILL.md 正文。与 BundleUrl 二选一。\n",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "VersionNote",
      "description": "版本说明。\n",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "VisibilityScope",
      "description": "可见性范围，按可见性级别取对应字段。\n",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ]
}
