{
  "name": "DeleteConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/api/v2/configs/[ClusterId]/[ConfigType]/[Name]/[ConfigKey]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "**集群/地域 ID**\n",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigKey",
      "description": "**要删除的配置项名称**\n",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigType",
      "description": "**配置类型**，目前仅支持 `service`\n",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "**服务名称**\n",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ]
}
