{
  "name": "ListConfigs",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/configs/[ClusterId]/[ConfigType]/[Name]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "**服务所属地域**（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigType",
      "description": "**配置类型**（必填），目前仅支持 `service`",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "**服务名称**（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Page",
      "description": "**页码**，默认为 1",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "**每页数量**，默认为 100，最大为 200",
      "position": "Query",
      "type": "Integer",
      "required": false
    }
  ]
}
