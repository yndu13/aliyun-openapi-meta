{
  "name": "CreateServiceRollout",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/rollout",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "地域ID。服务所在的地域标识，可通过ListServices接口获取可用地域列表。\n",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "description": "服务名称。要创建发布策略的服务名称，服务名称在同一地域内必须唯一。可通过DescribeService接口获取服务详情。\n",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "请求Body。",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ]
}
