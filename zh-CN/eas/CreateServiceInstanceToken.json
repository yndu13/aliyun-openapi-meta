{
  "name": "CreateServiceInstanceToken",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "/api/v2/services/[ClusterId]/[ServiceName]/instances/[InstanceName]/token",
  "parameters": [
    {
      "name": "ActionType",
      "description": "需要获取的链接类型。取值：\n- **WorkBench**：通过WorkBench页面登录容器。\n- **WebShell**：通过websocket地址登录容器。不支持processor类型的服务和2026年6月前创建的服务。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ClusterId",
      "description": "区域ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "InstanceName",
      "description": "服务实例的名字。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ServiceName",
      "description": "服务名字。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "WorkerName",
      "description": "服务worker的名称。您可以调用ListServiceContainers接口获取worker名称。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
