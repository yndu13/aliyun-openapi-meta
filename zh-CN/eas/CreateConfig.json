{
  "name": "CreateConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/configs/[ClusterId]/[ConfigType]/[Name]/[ConfigKey]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "**服务所属地域**（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigKey",
      "description": "**动态参数名称**（必填），支持字母、数字、点、下划线、连字符、斜杠，最大长度 100 字符",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigType",
      "description": "**配置类型**（必填），目前仅支持 `service`",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "**服务名称**（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "body",
      "description": "动态参数值（必填）",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ]
}
