      "type": "String",
      "required": false
    },
    {
      "name": "ClusterId",
      "description": "所属所在地域ID。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "GroupName",
      "description": "服务群组名称。",
      "position": "Path",
      "type": "String",
      "required": false
    }
  ]
}
