{
  "name": "UpdateConfig",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "PUT",
  "pathPattern": "/api/v2/configs/[ClusterId]/[ConfigType]/[Name]/[ConfigKey]",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群/地域 ID（必填），例如 `cn-hangzhou`",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigKey",
      "description": "动态参数名称（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "ConfigType",
      "description": "配置类型（必填），目前仅支持 `service`",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "Name",
      "description": "服务名称（必填）",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "body",
      "description": "动态参数值（必填）",
      "position": "Body",
      "type": "String",
      "required": false
    }
  ]
}
