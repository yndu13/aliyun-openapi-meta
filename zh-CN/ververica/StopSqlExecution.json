{
  "name": "StopSqlExecution",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/namespaces/[namespace]/sql-execution/[sqlExecutionId]:stop",
  "parameters": [
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "sqlExecutionId",
      "description": "SQL 查询执行结果的唯一标识 ID。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
