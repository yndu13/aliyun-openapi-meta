{
  "name": "ListAutopilotTuningHistories",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/autopilot/v2/namespaces/[namespace]/deployments/[deploymentId]/tuninghistories",
  "parameters": [
    {
      "name": "Accept-Language",
      "description": "语言类型，默认en-US，中文填写zh-CN。",
      "position": "Header",
      "type": "String",
      "required": false
    },
    {
      "name": "deploymentId",
      "description": "作业ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "endTime",
      "description": "查询结束时间戳（毫秒）。不传时默认为当前时间。startTime与endTime的跨度最多30天。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pageNumber",
      "description": "页码，从1开始，默认1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "pageSize",
      "description": "每页条数，默认20，最大100。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "startTime",
      "description": "查询起始时间戳（毫秒）。不传时默认查最近3天。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
