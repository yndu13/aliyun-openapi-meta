{
  "name": "StartSqlExecution",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v2/namespaces/[namespace]/sql-execution",
  "parameters": [
    {
      "name": "body",
      "description": "请求体，包含要执行的 SQL 内容及描述信息等。",
      "position": "Body",
      "type": "Json",
      "required": false
    },
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
