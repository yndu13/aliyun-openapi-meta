{
  "name": "ListPatrolReports",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/autopilot/v2/namespaces/[namespace]/patrol-reports",
  "parameters": [
    {
      "name": "endDate",
      "description": "查询结束时间（毫秒时间戳）。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "page",
      "description": "页码，从1开始，默认1。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "scopeType",
      "description": "巡检范围类型筛选。可选值：ALL、TAGS、DEPLOYMENTS。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "size",
      "description": "每页条数，默认20，最大200。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "startDate",
      "description": "查询起始时间（毫秒时间戳）。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "status",
      "description": "报告状态筛选。可选值：PENDING、IN_PROGRESS、COMPLETED、FAILED。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "triggerType",
      "description": "触发类型筛选。可选值：CRON、MANUAL、INNER_API。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
