{
  "name": "GetPatrolReportDetail",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/autopilot/v2/namespaces/[namespace]/patrol-reports/details",
  "parameters": [
    {
      "name": "date",
      "description": "报告日期（ISO格式如2026-08-13，或特殊值today/yesterday）。与reportId二选一，用于获取指定日期的最新报告。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "namespace",
      "description": "项目空间名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "reportId",
      "description": "报告ID。与date二选一，优先使用reportId。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "timezone",
      "description": "时区，配合date使用。默认UTC。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "workspace",
      "description": "工作空间ID。",
      "position": "Header",
      "type": "String",
      "required": true
    }
  ]
}
