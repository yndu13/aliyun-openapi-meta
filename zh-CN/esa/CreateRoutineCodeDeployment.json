{
  "name": "CreateRoutineCodeDeployment",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "CodeVersions",
      "description": "比例灰度版本号配置列表。最多支持两个版本号，且总比例之和等于100。",
      "position": "Body",
      "type": "Json",
      "required": true,
      "sub_parameters": [
        {
          "name": "CodeVersion",
          "description": "代码版本号。",
          "position": "FormData",
          "type": "String",
          "required": true
        },
        {
          "name": "Percentage",
          "description": "代码版本灰度比例。取值1-100。",
          "position": "FormData",
          "type": "Long",
          "required": true
        }
      ]
    },
    {
      "name": "Env",
      "description": "环境名  \n枚举值：\n- `staging`：测试环境 \n- `production`：生产环境",
      "position": "Body",
      "type": "String",
      "required": true
    },
    {
      "name": "Name",
      "description": "边缘函数Routine名。",
      "position": "Body",
      "type": "String",
      "required": true
    },
    {
      "name": "Strategy",
      "description": "部署策略  \n取值：\n- `percentage`：百分比模式",
      "position": "Body",
      "type": "String",
      "required": true
    }
  ]
}
