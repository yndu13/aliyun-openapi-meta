{
  "name": "OperateJob",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/tasks/[taskId]/jobs/[jobId]/operation/[operationType]",
  "parameters": [
    {
      "name": "comment",
      "description": "描述，长度（0-128）",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "jobId",
      "description": "作业ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "operationType",
      "description": "操作类型\n- execute：Plan完成后继续执行Apply操作\n- abolish：放弃已完成 Plan 预览的 Job\n- cancel：取消正在执行中或排队中的 Job",
      "position": "Path",
      "type": "String",
      "required": false
    },
    {
      "name": "taskId",
      "description": "任务ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "taskType",
      "description": "任务类型\n\nTask：常规任务（默认）\n\nSceneTestingTask：场景化测试任务",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
