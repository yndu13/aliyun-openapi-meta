{
  "name": "DescribeRCDisks",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET",
  "pathPattern": "",
  "parameters": [
    {
      "name": "DiskIds",
      "description": "磁盘ID。一个带有格式的JSON数组，最多支持100个ID，用英文逗号（,）隔开。输入格式为：`[\"磁盘 ID1\",\"磁盘 ID2\"]`。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "DiskType",
      "description": "要查询的云盘、或弹性临时盘类型。取值范围：\n● all：同时查询系统盘与数据盘。\n● system：只查询系统盘。\n● data：只查询数据盘。\n默认值：all。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "InstanceId",
      "description": "实例ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "PageNumber",
      "description": "页码。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "PageSize",
      "description": "每页记录数，取值：**30**~**100**。默认值：**30**。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "RegionId",
      "description": "地域ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Status",
      "description": "磁盘状态。取值范围：\n● In_use：使用中。\n● Available：待挂载。\n● Attaching：挂载中 。\n● Detaching：卸载中。\n● Creating：创建中。\n● ReIniting：初始化中。\n● All：所有状态。\n默认值：All。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Tag",
      "description": "标签列表。",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "标签键。**不允许**传入空值、重复。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Value",
          "description": "标签值。**允许**传入空值。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
