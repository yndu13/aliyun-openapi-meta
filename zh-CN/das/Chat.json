{
  "name": "Chat",
  "deprecated": false,
  "protocol": "HTTPS|SSE",
  "method": "POST",
  "pathPattern": "/chat",
  "parameters": [
    {
      "name": "AgentId",
      "description": "可选，用于服务的 Agent ID。可指定为开启 DAS Agent 后生成的Agent 或主动创建的 Agent。如未指定则使用默认 Agent 进行服务。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Message",
      "description": "消息",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SessionId",
      "description": "可选，会话 ID，格式为 UUID 字符串。如未指定默认创建新的会话。上下文对话需保持同一个会话 ID。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Summary",
      "description": "是否输出摘要信息",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
