{
  "name": "CreateRepoSyncRule",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "InstanceId",
      "description": "源实例 ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "LinkId",
      "description": "同步自定义链路ID",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NamespaceName",
      "description": "源实例命名空间名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NamespaceNameFilter",
      "description": "实例级别命名空间正则\n> 该参数仅在同步类型 SyncScope 是 `INSTANCE` 时有效。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Priority",
      "description": "同步任务执行优先级。同步任务按照该优先级从大到小的顺序被执行。相同优先级的同步任务按随机顺序执行。\n\n取值范围：1～5\n\n默认值：3",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "RepoName",
      "description": "源实例仓库名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "RepoNameFilter",
      "description": "仓库过滤规则。\n> 该参数仅在同步类型 SyncScope 是 `INSTANCE` 或 `NAMESPACE` 时有效。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SyncRuleName",
      "description": "同步规则名称。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SyncScope",
      "description": "同步类型，取值：\n\n- `REPO`：按照镜像仓库同步。\n\n- `NAMESPACE`：按照命名空间同步。\n\n- `INSTANCE`：按照命名空间正则和仓库正则同步。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "SyncTrigger",
      "description": "触发同步动作，取值：\n\n- `INITIATIVE`：手动触发。\n \n- `PASSIVE`：自动触发。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TagFilter",
      "description": "Tag过滤规则。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "TargetInstanceId",
      "description": "目标实例 ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "TargetNamespaceName",
      "description": "目标实例命名空间名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TargetRegionId",
      "description": "目标实例地区 ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "TargetRepoName",
      "description": "目标实例镜像仓库名称。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TargetUserId",
      "description": "目标实例所在的账号UID。\n\n> 跨账号同步镜像时，需要使用账号UID。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
