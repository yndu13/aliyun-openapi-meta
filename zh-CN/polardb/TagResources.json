{
  "name": "TagResources",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "RegionId",
      "description": "地域ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ResourceId",
      "description": "目标集群ID。",
      "position": "Query",
      "type": "RepeatList",
      "required": true
    },
    {
      "name": "ResourceType",
      "description": "资源类型，取值固定为**cluster**。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Tag",
      "description": "标签列表。",
      "position": "Query",
      "type": "RepeatList",
      "required": true,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "标签键。若您需要为目标集群一次性添加多个标签，请单击**添加**来添加标签键。\n\n>每次最多添加20对标签，`Tag.n.Key`对应的值为`Tag.n.Value`。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Value",
          "description": "标签值。若您需要为目标集群一次性添加多个标签，请单击**添加**来添加标签值。\n\n>每次最多添加20对标签，`Tag.n.Value`对应的值为`Tag.n.Key`。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
