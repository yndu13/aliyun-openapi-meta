{
  "name": "ListProtectionPolicyApplications",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/protection-policies/[ProtectionPolicyId]/list-applications",
  "parameters": [
    {
      "name": "ApplyStatus",
      "description": "应用状态",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "MaxResults",
      "description": "本次请求所返回的最大记录条数",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "NextToken",
      "description": "分页游标，如果有下一页，则该字段有返回值。说明 该参数只要返回数据，则说明还有下一页。您可以将返回的NextToken作为请求参数再次获得下一页的数据，直到返回为Null，表示获取到了所有的数据。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ProtectionPolicyId",
      "description": "保护策略ID",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "ResourceType",
      "description": "资源类型",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "SubProtectionPolicyType",
      "description": "子保护策略类型",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "TaskId",
      "description": "任务ID。您可以调用DescribeTasks查看任务ID。",
      "position": "Query",
      "type": "String",
      "required": true
    }
  ]
}
