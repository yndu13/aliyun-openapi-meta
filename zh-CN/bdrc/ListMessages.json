{
  "name": "ListMessages",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/api/v1/messages",
  "parameters": [
    {
      "name": "MaxResults",
      "description": "本次请求所返回的最大记录条数",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "MessageLevel",
      "description": "消息等级",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "MessageTimeEarlierThan",
      "description": "消息时间早于",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "MessageTimeLaterThan",
      "description": "消息时间晚于",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "MessageType",
      "description": "消息类型",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "NextToken",
      "description": "分页游标，如果有下一页，则该字段有返回值。说明 该参数只要返回数据，则说明还有下一页。您可以将返回的NextToken作为请求参数再次获得下一页的数据，直到返回为Null，表示获取到了所有的数据。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
