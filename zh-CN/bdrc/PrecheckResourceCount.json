{
  "name": "PrecheckResourceCount",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "POST",
  "pathPattern": "/api/v1/resources/precheck-count",
  "parameters": [
    {
      "name": "ResourceType",
      "description": "资源类型。可选。不填则不限制资源类型。",
      "position": "Body",
      "type": "String",
      "required": false
    },
    {
      "name": "TagResourceMatchers",
      "description": "标签资源匹配器。必填。按标签匹配资源的规则列表，每项包含key（标签键）、operator（操作符，支持EQUAL标签键值相等、KEY_EXIST标签键存在、KEY_EXIST_NOT_EQUAL标签键存在但值不相等）、values（标签值列表）。",
      "position": "Body",
      "type": "Json",
      "required": true,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "标签的键",
          "position": "FormData",
          "type": "String",
          "required": true
        },
        {
          "name": "Operator",
          "description": "运算符",
          "position": "FormData",
          "type": "String",
          "required": true
        },
        {
          "name": "Values",
          "description": "标签值列表",
          "position": "FormData",
          "type": "RepeatList",
          "required": false
        }
      ]
    }
  ]
}
