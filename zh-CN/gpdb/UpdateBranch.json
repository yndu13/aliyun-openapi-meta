{
  "name": "UpdateBranch",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET|POST",
  "pathPattern": "",
  "parameters": [
    {
      "name": "BranchId",
      "description": "分支 ID，用于唯一标识一个 Supabase 分支。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "BranchName",
      "description": "分支名称。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "ClearExpiresAt",
      "description": "是否清空分支过期时间。\n\n取值：\n- true：清空 ExpiresAt。\n- false：不清空 ExpiresAt。\n\n不传时保持原过期时间不变。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "Description",
      "description": "分支描述信息。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ExpiresAt",
      "description": "分支过期自动删除时间，格式为 ISO 8601 UTC 时间。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "ProjectId",
      "description": "主分支对应的 Supabase 项目 ID。",
      "position": "Query",
      "type": "String",
      "required": true
    },
    {
      "name": "Protected",
      "description": "是否开启分支保护。\n\n取值：\n- true：开启分支保护。\n- false：关闭分支保护，默认值。",
      "position": "Query",
      "type": "Boolean",
      "required": false
    },
    {
      "name": "RegionId",
      "description": "地域 ID。创建主分支时必须指定，创建子分支时默认继承主分支所在地域。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "Tag",
      "description": "分支标签列表。",
      "position": "Query",
      "type": "RepeatList",
      "required": false,
      "sub_parameters": [
        {
          "name": "Key",
          "description": "标签键。",
          "position": "Query",
          "type": "String",
          "required": false
        },
        {
          "name": "Value",
          "description": "标签值。",
          "position": "Query",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
