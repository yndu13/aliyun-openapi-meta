{
  "name": "UpgradeClusterAddons",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/upgrade",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "请求参数。",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "component_name",
          "description": "组件名称。",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "config",
          "description": "组件自定义参数，使用JSON字符串编码。",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "next_version",
          "description": "待升级的目标版本。您可以调用`DescribeAddon`接口查看组件可升级的版本。",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "policy",
          "description": "组件升级策略。可选值：\n- overwrite：覆盖升级。\n- canary：金丝雀升级。",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "version",
          "description": "当前组件版本。",
          "position": "Body",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
