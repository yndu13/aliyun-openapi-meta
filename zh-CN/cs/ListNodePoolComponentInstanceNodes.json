{
  "name": "ListNodePoolComponentInstanceNodes",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "GET",
  "pathPattern": "/clusters/[cluster_id]/nodepools/[nodepool_id]/component_instances/[name]/nodes",
  "parameters": [
    {
      "name": "cluster_id",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "config_revision",
      "description": "过滤指定节点组件配置版本号的节点。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "max_results",
      "description": "分页控制：单次响应返回的最大记录数。默认 20。",
      "position": "Query",
      "type": "Integer",
      "required": false
    },
    {
      "name": "name",
      "description": "组件名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "next_token",
      "description": "分页游标：首次请求不传；后续请求填入上一次响应返回的 token。",
      "position": "Query",
      "type": "String",
      "required": false
    },
    {
      "name": "node_names",
      "description": "指定查询节点名称列表。",
      "position": "Query",
      "type": "Json",
      "required": false
    },
    {
      "name": "nodepool_id",
      "description": "节点池ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "version",
      "description": "过滤指定节点组件版本的节点。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
