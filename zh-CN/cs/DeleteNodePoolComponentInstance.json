{
  "name": "DeleteNodePoolComponentInstance",
  "deprecated": false,
  "protocol": "HTTPS",
  "method": "DELETE",
  "pathPattern": "/clusters/[cluster_id]/nodepools/[nodepool_id]/component_instances/[name]",
  "parameters": [
    {
      "name": "batch_interval",
      "description": "批次之间的间隔时间，单位秒，默认0。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "cluster_id",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "max_failed_nodes",
      "description": "允许滚动过程中失败的最大节点数。默认为0，即任一节点失败即判定任务失败；大于0时，累计失败节点数超过该值则整体判定失败并停止。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "max_parallelism",
      "description": "每批次的最大并行数，默认值1。",
      "position": "Query",
      "type": "Long",
      "required": false
    },
    {
      "name": "name",
      "description": "组件名称。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "node_names",
      "description": "指定轮转的节点列表，默认为全部节点。",
      "position": "Query",
      "type": "Json",
      "required": false
    },
    {
      "name": "nodepool_id",
      "description": "节点池ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "pause_policy",
      "description": "节点升级过程中的自动暂停策略。\n- NotPause\n- FirstBatch\n- EveryBatch\n\n默认策略NotPause。",
      "position": "Query",
      "type": "String",
      "required": false
    }
  ]
}
