{
  "name": "InstallClusterAddons",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/install",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "body",
      "description": "请求体参数。",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "config",
          "description": "组件自定义参数，使用JSON字符串编码。",
          "position": "Body",
          "type": "String",
          "required": false
        },
        {
          "name": "name",
          "description": "组件名称。您可以通过[ListAddons](~~2667939~~)接口查询可用组件的信息，包括组件名称及版本等。",
          "position": "Body",
          "type": "String",
          "required": true
        },
        {
          "name": "version",
          "description": "组件版本。您可以通过[ListAddons](~~2667939~~)接口查询可用组件的信息，包括组件名称及版本等。",
          "position": "Body",
          "type": "String",
          "required": true
        }
      ]
    }
  ]
}
