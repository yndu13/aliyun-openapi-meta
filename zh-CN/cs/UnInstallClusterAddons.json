{
  "name": "UnInstallClusterAddons",
  "deprecated": false,
  "protocol": "HTTP|HTTPS",
  "method": "POST",
  "pathPattern": "/clusters/[ClusterId]/components/uninstall",
  "parameters": [
    {
      "name": "ClusterId",
      "description": "集群ID。",
      "position": "Path",
      "type": "String",
      "required": true
    },
    {
      "name": "addons",
      "description": "组件列表。",
      "position": "Body",
      "type": "Json",
      "required": false,
      "sub_parameters": [
        {
          "name": "cleanup_cloud_resources",
          "description": "卸载组件时是否清理相关的云资源。\n-  true：清理。\n- false：保留。",
          "position": "Body",
          "type": "Boolean",
          "required": false
        },
        {
          "name": "name",
          "description": "待卸载的组件名称。您可以调用[ListClusterAddonInstances](~~2667940~~)接口查询集群中已安装的组件。",
          "position": "Body",
          "type": "String",
          "required": false
        }
      ]
    }
  ]
}
